# Normalise line endings so diffs stay readable across Windows/Linux
# checkouts. Without this, LICENSE, Golden_model/*.py and vectors.hex show
# up as fully rewritten in every `git diff`.
* text=auto eol=lf

# Verilog / SystemVerilog
*.v      text eol=lf
*.sv     text eol=lf
*.vh     text eol=lf

# Scripts, config, docs
*.py     text eol=lf
*.sh     text eol=lf
*.ys     text eol=lf
*.sby    text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
Makefile text eol=lf

# Golden vectors: plain text, but huge — mark as such so git does not try
# to be clever, and keep them out of diff output.
*.hex    text eol=lf -diff

# Binary artefacts
*.gds    binary
*.fst    binary
*.vcd    binary
*.pdf    binary
*.png    binary
*.sqlite binary
