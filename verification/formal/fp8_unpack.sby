# SymbiYosys — combinational classification proof for fp8_unpack.
# Pure combinational: BMC depth 1 checks all 256 inputs symbolically.
#   sby -f fp8_unpack.sby

[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 1
cover: mode cover
cover: depth 1

[engines]
smtbmc

[script]
read_verilog -sv -formal -I. header_fp8.v
read_verilog -formal -I. fp8_unpack.v
read_verilog -sv -formal -I. fp8_unpack_fv.sv
prep -top fp8_unpack_fv

[files]
../../src/header_fp8.v
../../src/fp8_unpack.v
fp8_unpack_fv.sv
