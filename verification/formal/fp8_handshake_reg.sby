# SymbiYosys — formal contract for the depth-1 elastic buffer.
#   sby -f fp8_handshake_reg.sby            # runs both tasks
#   sby -f fp8_handshake_reg.sby prove      # safety/induction only
#   sby -f fp8_handshake_reg.sby cover       # reachability only

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 10

[engines]
smtbmc

[script]
read_verilog -sv -formal -I. fp8_handshake_reg.v
read_verilog -sv -formal -I. fp8_handshake_reg_fv.sv
prep -top fp8_handshake_reg_fv

[files]
../../src/header_fp8.v
../../src/fp8_handshake_reg.v
fp8_handshake_reg_fv.sv
